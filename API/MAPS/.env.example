# Copy to .env (or API_KEY.env) and fill in for local/deployed runs.
# The API reads real environment variables first, then .env / API_KEY.env.

# WeatherAPI key used by /risk, /heatmap and the alert poller.
WEATHER_API_KEY=

# Comma-separated browser origins allowed to call the API.
# Leave unset for the localhost defaults; set explicitly in production.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Rate limiting. Use redis://... in production so limits survive restarts
# and are shared across workers.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_STORAGE=memory://

# Routing. Point at a self-hosted OSRM for more than 2 alternatives.
OSRM_BASE_URL=http://router.project-osrm.org

# Delete risk/route logs older than this many days (0 disables pruning).
LOG_RETENTION_DAYS=90

# Port used by the Procfile / Dockerfile when the host injects PORT.
PORT=5000

# Where the SQLite risk/route log is written. Defaults to sober.db next to the
# application code. Point it at a writable volume (e.g. /tmp/sober.db) when the
# app directory is read-only, which is the case in the Docker image.
SOBER_DB_PATH=
